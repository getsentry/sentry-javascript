{
  "attribution": {
    "sessionUrl": false
  },
  "env": { "ENABLE_LSP_TOOL": "1" },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "if [ \"$CLAUDE_CODE_REMOTE\" = \"true\" ]; then bash \"$CLAUDE_PROJECT_DIR\"/scripts/claude-cloud-setup.sh; fi"
          }
        ]
      }
    ]
  }
}
