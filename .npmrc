# Yarn 1 did not install peer dependencies, and some packages break with the versions that pnpm would add.
auto-install-peers=false
strict-peer-dependencies=false
link-workspace-packages=true
prefer-workspace-packages=true
shamefully-hoist=true
# A flat node_modules folder like Yarn 1, because some packages and configs import dependencies that they do not declare.
node-linker=hoisted
