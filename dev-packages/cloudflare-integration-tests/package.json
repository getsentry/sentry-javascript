    "@prisma/adapter-d1": "6.15.0",
    "@prisma/client": "6.15.0",
    "@sentry/cloudflare": "11.0.0-alpha.1",
    "@sentry/core": "11.0.0-alpha.1",
    "@sentry/hono": "11.0.0-alpha.1",
    "hono": "^4.12.34",
    "openai": "5.18.1"
