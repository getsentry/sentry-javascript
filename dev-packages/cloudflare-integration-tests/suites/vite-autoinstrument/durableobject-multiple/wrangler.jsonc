{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "cloudflare-vite-autoinstrument-durableobject-multiple",
  // `main` points at the source entry; the Sentry Vite plugin builds from it (so
  // the auto-instrument transform runs) and the runner serves the built output.
  "main": "index.ts",
  "compatibility_date": "2025-06-17",
  "compatibility_flags": ["nodejs_als"],
  "durable_objects": {
    "bindings": [
      { "name": "COUNTER_A", "class_name": "CounterA" },
      { "name": "COUNTER_B", "class_name": "CounterB" },
    ],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CounterA", "CounterB"] }],
}
