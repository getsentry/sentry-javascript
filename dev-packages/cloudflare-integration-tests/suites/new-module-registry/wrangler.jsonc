{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "new-module-registry",
  "main": "index.ts",
  "compatibility_date": "2025-06-17",
  // `new_module_registry` becomes the default for compatibility dates from 2026-11-17 on.
  "compatibility_flags": ["nodejs_compat", "new_module_registry"],
  "durable_objects": {
    "bindings": [{ "name": "TEST_DURABLE_OBJECT", "class_name": "TestDurableObject" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TestDurableObject"] }],
}
