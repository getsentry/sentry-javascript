  "scripts": {
    "build": "pnpm run build:transpile && pnpm run build:types",
    "build:dev": "pnpm run build",
    "build:transpile": "rollup -c rollup.npm.config.mjs",
    "build:types": "tsc -p tsconfig.types.json",
    "clean": "rimraf -g suites/**/node_modules suites/**/tmp_* && pnpm run clean:script",
    "clean:script": "node scripts/clean.js",
    "lint": "oxlint . --type-aware",
    "lint:fix": "oxlint . --fix --type-aware",
    "type-check": "pnpm run type-check:src && pnpm run type-check:test",
    "type-check:src": "tsc --noEmit",
    "type-check:test": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "pnpm run test --watch"
  },
