{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": ["../.oxlintrc.json"],
  "env": {
    "node": true
  },
  "overrides": [
    {
      "files": ["suites/**/*.ts", "suites/**/*.mjs"],
      "globals": {
        "fetch": "readonly"
      },
      "rules": {
        "typescript/ban-ts-comment": [
          "error",
          {
            "ts-ignore": "allow-with-description",
            "ts-expect-error": true
          }
        ],
        "import/first": "off"
      }
    },
    {
      "files": ["suites/**/test.ts", "suites/**/*.test.ts"],
      "rules": {
        "no-restricted-properties": [
          "error",
          {
            "object": "process",
            "property": "version",
            "message": "Gate the test with `test.runIf(supports({ ... }))` from `utils/index.ts` instead."
          },
          {
            "object": "process",
            "property": "versions",
            "message": "Gate the test with `test.runIf(supports({ ... }))` from `utils/index.ts` instead."
          },
          {
            "object": "ctx",
            "property": "skip",
            "message": "Gate the test with `test.runIf(supports({ ... }))` from `utils/index.ts` instead."
          },
          {
            "object": "context",
            "property": "skip",
            "message": "Gate the test with `test.runIf(supports({ ... }))` from `utils/index.ts` instead."
          }
        ]
      }
    }
  ]
}
