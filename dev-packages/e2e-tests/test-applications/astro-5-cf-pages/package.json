{
  "name": "astro-5-cf-pages",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler pages dev ./dist --port 3030",
    "test:build": "pnpm install && pnpm build",
    "test:assert": "TEST_ENV=production playwright test",
    "test:build:tunnel": "pnpm install && PUBLIC_E2E_TEST_TUNNEL=1 PUBLIC_E2E_TEST_DSN=http://public@localhost:3031/1337 pnpm build",
    "test:assert:tunnel": "PUBLIC_E2E_TEST_TUNNEL=1 TEST_ENV=production playwright test tunnel"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.12",
    "@playwright/test": "1.64.1",
    "@sentry-internal/test-utils": "file:../../packed/sentry-internal-test-utils-packed.tgz",
    "@sentry/astro": "file:../../packed/sentry-astro-packed.tgz",
    "@sentry/cloudflare": "file:../../packed/sentry-cloudflare-packed.tgz",
    "astro": "^5.17.1"
  },
  "devDependencies": {
    "wrangler": "^4.63.0"
  },
  "sentryTest": {
    "variants": [
      {
        "build-command": "pnpm test:build:tunnel",
        "assert-command": "pnpm test:assert:tunnel",
        "label": "astro-5-cf-pages (tunnel)"
      }
    ]
  }
}
