{
  "name": "node-flue-send-to-sentry",
  "description": "The Flue integration as a user runs it: a built Flue agent server, real tool-calling turns through OpenRouter, and the gen_ai spans read back from a real Sentry project",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "start": "NODE_OPTIONS='--import=@sentry/node/import' PORT=3030 node dist/server.mjs",
    "test": "OPENROUTER_API_KEY=$E2E_OPENROUTER_API_KEY playwright test",
    "clean": "npx rimraf node_modules dist pnpm-lock.yaml",
    "test:build": "pnpm install && pnpm build",
    "test:build-latest": "pnpm install && pnpm add @flue/runtime@latest @flue/vite@latest @flue/cli@latest && pnpm build",
    "test:assert": "pnpm test"
  },
  "dependencies": {
    "@flue/runtime": "2.0.5",
    "@sentry/node": "file:../../packed/sentry-node-packed.tgz",
    "dataloader": "^2.2.3",
    "hono": "^4.7.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@flue/cli": "2.0.5",
    "@flue/vite": "2.0.5",
    "@playwright/test": "1.64.1",
    "@sentry-internal/test-utils": "file:../../packed/sentry-internal-test-utils-packed.tgz",
    "@sentry/conventions": "0.27.0",
    "@types/node": "24.x",
    "sentry": "~0.44.1",
    "typescript": "~5.9.0",
    "vite": "^8.0.14"
  },
  "engines": {
    "node": "24.x"
  },
  "volta": {
    "extends": "../../package.json"
  },
  "sentryTest": {
    "optional": true,
    "optionalVariants": [
      {
        "build-command": "pnpm test:build-latest",
        "label": "node-flue-send-to-sentry (latest)"
      }
    ]
  }
}
