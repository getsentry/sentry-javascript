{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Placeholder only: every test run deploys under a unique name, see global-setup.ts.
  "name": "cloudflare-workers-without-tracing-send-to-sentry",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // The tests read the Cloudflare trace of each request from Workers Logs.
  "observability": { "enabled": true, "traces": { "enabled": true } },
}
