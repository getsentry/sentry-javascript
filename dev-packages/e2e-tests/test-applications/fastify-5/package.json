{
  "name": "fastify-5",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "start:bun": "bun dist/main.js",
    "start:deno": "deno run -A --preload=@sentry/deno/import --preload=./src/instrument.ts src/main.ts",
    "test": "playwright test",
    "clean": "npx rimraf node_modules pnpm-lock.yaml",
    "test:build": "pnpm install && pnpm build",
    "test:assert": "pnpm test"
  },
  "dependencies": {
    "@sentry/bun": "file:../../packed/sentry-bun-packed.tgz",
    "@sentry/deno": "file:../../packed/sentry-deno-packed.tgz",
    "@sentry/node": "file:../../packed/sentry-node-packed.tgz",
    "@types/node": "^18.19.1",
    "fastify": "^5.7.0",
    "typescript": "5.6.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sentry-internal/test-utils": "file:../../packed/sentry-internal-test-utils-packed.tgz",
    "@sentry/core": "file:../../packed/sentry-core-packed.tgz"
  },
  "sentryTest": {
    "optionalVariants": [
      {
        "runtime": "bun",
        "bun-version": "1.4.5",
        "label": "fastify-5 (bun)"
      },
      {
        "runtime": "deno",
        "label": "fastify-5 (deno)"
      }
    ]
  }
}
