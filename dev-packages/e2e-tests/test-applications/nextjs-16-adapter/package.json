{
  "name": "nextjs-16-adapter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build > .tmp_build_stdout 2> .tmp_build_stderr || (cat .tmp_build_stdout && cat .tmp_build_stderr && exit 1)",
    "clean": "npx rimraf node_modules pnpm-lock.yaml .tmp_dev_server_logs",
    "start": "node server.mjs",
    "test:prod": "TEST_ENV=production playwright test",
    "test:build": "pnpm install && pnpm build",
    "test:build-latest": "pnpm install && pnpm add next@latest && pnpm build",
    "test:assert": "pnpm test:prod"
  },
  "dependencies": {
    "@sentry/nextjs": "file:../../packed/sentry-nextjs-packed.tgz",
    "next": "16.4.5",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sentry-internal/test-utils": "file:../../packed/sentry-internal-test-utils-packed.tgz",
    "@sentry/conventions": "0.31.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5"
  },
  "sentryTest": {
    "runner": "namespace-profile-sentry-javascript",
    "variants": [
      {
        "build-command": "pnpm test:build",
        "label": "nextjs-16-adapter (turbopack)",
        "assert-command": "pnpm test:assert"
      },
      {
        "build-command": "pnpm test:build-latest",
        "label": "nextjs-16-adapter (latest, turbopack)",
        "assert-command": "pnpm test:assert"
      }
    ]
  }
}
