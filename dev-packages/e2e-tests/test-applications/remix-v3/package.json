{
  "name": "remix-v3-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "NODE_ENV=production node --import @sentry/remix/v3/node server.ts",
    "test": "playwright test",
    "clean": "npx rimraf node_modules pnpm-lock.yaml",
    "test:build": "pnpm install",
    "test:assert": "pnpm test",
    "test:assert:tunnel": "E2E_TEST_TUNNEL=1 E2E_TEST_DSN=http://public@localhost:3061/1337 playwright test tunnel"
  },
  "dependencies": {
    "@sentry/remix": "file:../../packed/sentry-remix-packed.tgz",
    "remix": "3.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sentry-internal/test-utils": "file:../../packed/sentry-internal-test-utils-packed.tgz",
    "@sentry/core": "file:../../packed/sentry-core-packed.tgz",
    "@types/node": "^24.6.0",
    "typescript": "~5.9.0"
  },
  "volta": {
    "extends": "../../package.json"
  },
  "sentryTest": {
    "variants": [
      {
        "build-command": "pnpm test:build",
        "assert-command": "pnpm test:assert:tunnel",
        "label": "remix-v3 (tunnel)"
      }
    ]
  }
}
