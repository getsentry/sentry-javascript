{
  "name": "solidstart-2",
  "version": "0.0.0",
  "//": "Sentry is initialized from server/plugins/sentry.ts, a Nitro plugin. Build-time instrumentation means there is no `--import` preload and nothing to copy into .output.",
  "scripts": {
    "clean": "pnpx rimraf node_modules pnpm-lock.yaml .nitro .output",
    "build": "node start-mock-sentry-server.mjs & vite build > .tmp_build_stdout 2> .tmp_build_stderr; BUILD_EXIT=$?; kill %1 2>/dev/null; if [ $BUILD_EXIT -ne 0 ]; then cat .tmp_build_stdout; cat .tmp_build_stderr >&2; fi; exit $BUILD_EXIT",
    "preview": "HOST=localhost PORT=3030 vite preview",
    "start": "HOST=localhost PORT=3030 node .output/server/index.mjs",
    "test:prod": "TEST_ENV=production playwright test",
    "test:build": "pnpm install && pnpm build",
    "test:assert": "node assert-build.ts && pnpm test:prod"
  },
  "type": "module",
  "dependencies": {
    "@sentry/solidstart": "file:../../packed/sentry-solidstart-packed.tgz",
    "nitro": "3.0.260610-beta"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sentry-internal/test-utils": "file:../../packed/sentry-internal-test-utils-packed.tgz",
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^1.0.0",
    "@solidjs/start": "2.0.2",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/user-event": "^14.5.2",
    "jsdom": "^24.0.0",
    "solid-js": "1.9.14",
    "typescript": "^5.4.5",
    "vite": "^8.1.5",
    "vite-plugin-solid": "^2.11.6"
  },
  "engines": {
    "node": ">=24"
  },
  "sentryTest": {
    "optional": true
  }
}
