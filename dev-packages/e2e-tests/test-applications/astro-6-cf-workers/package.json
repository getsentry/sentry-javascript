{
  "name": "astro-6-cf-workers",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "start": "wrangler dev --var \"E2E_TEST_DSN:$E2E_TEST_DSN\" --port 3030",
    "test:build": "pnpm install && pnpm build",
    "test:assert": "TEST_ENV=production playwright test",
    "cf-typegen": "wrangler types --include-runtime=false",
    "test:build:tunnel": "pnpm install && PUBLIC_E2E_TEST_TUNNEL=1 PUBLIC_E2E_TEST_DSN=http://public@localhost:3031/1337 pnpm build",
    "test:assert:tunnel": "PUBLIC_E2E_TEST_TUNNEL=1 E2E_TEST_DSN=http://public@localhost:3031/1337 TEST_ENV=production playwright test tunnel"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.0.2",
    "@playwright/test": "1.64.1",
    "@sentry-internal/test-utils": "file:../../packed/sentry-internal-test-utils-packed.tgz",
    "@sentry/astro": "file:../../packed/sentry-astro-packed.tgz",
    "@sentry/cloudflare": "file:../../packed/sentry-cloudflare-packed.tgz",
    "astro": "^6.0.0",
    "mysql": "2.18.1",
    "wrangler": "^4.72.0"
  },
  "sentryTest": {
    "variants": [
      {
        "build-command": "pnpm test:build:tunnel",
        "assert-command": "pnpm test:assert:tunnel",
        "label": "astro-6-cf-workers (tunnel)"
      }
    ]
  }
}
