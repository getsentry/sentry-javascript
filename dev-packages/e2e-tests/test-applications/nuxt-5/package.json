{
  "name": "nuxt-5",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "start": "node .output/server/index.mjs",
    "start:bun": "bun .output/server/index.mjs",
    "start:deno": "deno run -A .output/server/index.mjs",
    "start:cloudflare": "wrangler dev --port 3030",
    "start:import": "node --import ./.output/server/sentry.server.config.mjs .output/server/index.mjs",
    "clean": "npx nuxi cleanup",
    "test": "playwright test",
    "test:prod": "TEST_ENV=production playwright test",
    "test:dev": "TEST_ENV=development playwright test environment",
    "test:build": "pnpm install && pnpm build",
    "test:build-canary": "pnpm add nuxt@npm:nuxt-nightly@latest && pnpm add nitro@npm:nitro-nightly@latest && pnpm install --force && pnpm build",
    "test:assert": "pnpm test:prod && pnpm test:dev",
    "test:build:kv-cache": "pnpm install && E2E_TEST_CACHE_DRIVER=kv pnpm build",
    "test:assert:kv-cache": "E2E_TEST_CACHE_DRIVER=kv TEST_ENV=production playwright test cache",
    "test:build:bun": "pnpm install && bun --bun nuxt build",
    "test:build:cloudflare": "rm sentry.server.config.ts && pnpm test:build"
  },
  "//": [
    "Currently, we need to install the Nuxt nightlies as those contain Nuxt v5",
    "Nuxt generates `fetch.server.mjs` as a virtual module that imports `ofetch`, and since a virtual id is neither absolute nor on disk, Vite resolves from its `root` (the srcDir) instead of the importer's folder.",
    "This fails because `ofetch` is a dependency of `nuxt` rather than the app, so pnpm leaves it in `.pnpm/`",
    "TODO: remove ofetch from dependencies: https://github.com/getsentry/sentry-javascript/pull/24283#issuecomment-5615854158"
  ],
  "dependencies": {
    "@pinia/nuxt": "^0.11.3",
    "@sentry/bun": "file:../../packed/sentry-bun-packed.tgz",
    "@sentry/cloudflare": "file:../../packed/sentry-cloudflare-packed.tgz",
    "@sentry/deno": "file:../../packed/sentry-deno-packed.tgz",
    "@sentry/nuxt": "file:../../packed/sentry-nuxt-packed.tgz",
    "db0": "^0.4.2",
    "mongoose": "^9.10.2",
    "ofetch": "^2.0.0-alpha.3",
    "nuxt": "npm:nuxt-nightly@5x",
    "vue": "^3.5.41",
    "vue-router": "^5.5.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sentry/conventions": "0.36.0",
    "@sentry-internal/test-utils": "file:../../packed/sentry-internal-test-utils-packed.tgz",
    "wrangler": "^4.72.0"
  },
  "sentryTest": {
    "optional": true,
    "baseVariant": {
      "assert-command": "pnpm test:prod"
    },
    "optionalVariants": [
      {
        "build-command": "pnpm install",
        "assert-command": "pnpm test:dev",
        "label": "nuxt-5 (development)"
      },
      {
        "build-command": "pnpm test:build:kv-cache",
        "assert-command": "pnpm test:assert:kv-cache",
        "label": "nuxt-5 (kv-cache)"
      },
      {
        "runtime": "bun",
        "build-command": "pnpm test:build:bun",
        "assert-command": "pnpm test:prod",
        "label": "nuxt-5 (bun)"
      },
      {
        "runtime": "deno",
        "deno-version": "v2.9.0",
        "assert-command": "pnpm test:prod",
        "label": "nuxt-5 (deno)"
      },
      {
        "runtime": "cloudflare",
        "build-command": "pnpm test:build:cloudflare",
        "assert-command": "pnpm test:prod",
        "label": "nuxt-5 (cloudflare)"
      }
    ]
  }
}
