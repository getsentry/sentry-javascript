{
  "name": "node-nitro-3",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nitro build",
    "start": "PORT=3030 node .output/server/index.mjs",
    "clean": "npx rimraf node_modules pnpm-lock.yaml .output .nitro",
    "test:prod": "TEST_ENV=production playwright test",
    "test:dev": "TEST_ENV=development playwright test",
    "test:build": "pnpm install && pnpm build",
    "test:build:server-dir": "pnpm install && E2E_SERVER_DIR=1 pnpm build",
    "test:dev:server-dir": "E2E_SERVER_DIR=1 pnpm test:dev",
    "test:assert": "pnpm test:prod"
  },
  "dependencies": {
    "@sentry/node": "latest || *",
    "h3": "^2.0.8",
    "nitro": "^3.0.261103-rc",
    "unstorage": "^2.0.0-beta.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sentry-internal/test-utils": "file:../../packed/sentry-internal-test-utils-packed.tgz",
    "@sentry/conventions": "0.36.0",
    "@types/node": "^20",
    "rolldown": "latest"
  },
  "sentryTest": {
    "baseVariant": {
      "build-command": "pnpm test:build",
      "assert-command": "pnpm test:prod",
      "label": "node-nitro-3 (production)"
    },
    "variants": [
      {
        "build-command": "pnpm install",
        "assert-command": "pnpm test:dev",
        "label": "node-nitro-3 (development)"
      },
      {
        "build-command": "pnpm test:build:server-dir",
        "assert-command": "pnpm test:prod",
        "label": "node-nitro-3 (production, serverDir)"
      },
      {
        "build-command": "pnpm install",
        "assert-command": "pnpm test:dev:server-dir",
        "label": "node-nitro-3 (development, serverDir)"
      }
    ]
  }
}
