{
  "name": "node-nitro-3",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:nitro": "NITRO_BUILDER=rolldown nitro build",
    "start": "PORT=3030 node --import @sentry/node/import .output/server/index.mjs",
    "clean": "npx rimraf node_modules pnpm-lock.yaml .output",
    "test:prod": "TEST_ENV=production playwright test",
    "test:dev": "TEST_ENV=development playwright test",
    "test:nitro-prod": "TEST_ENV=prod-nitro playwright test",
    "test:nitro-dev": "TEST_ENV=dev-nitro playwright test",
    "test:build": "pnpm install && pnpm build",
    "test:build:nitro": "pnpm install && pnpm build:nitro",
    "test:build:tracing-channel": "pnpm install && E2E_NITRO_TRACING_CHANNEL=1 pnpm build",
    "test:prod:tracing-channel": "E2E_NITRO_TRACING_CHANNEL=1 pnpm test:prod",
    "test:assert": "pnpm test:prod"
  },
  "dependencies": {
    "@sentry/node": "latest || *"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sentry-internal/test-utils": "file:../../packed/sentry-internal-test-utils-packed.tgz",
    "@sentry/conventions": "0.36.0",
    "h3": "latest",
    "nitro": "latest",
    "rolldown": "latest",
    "vite": "latest"
  },
  "sentryTest": {
    "baseVariant": {
      "build-command": "pnpm test:build",
      "assert-command": "pnpm test:prod",
      "label": "node-nitro-3 (vite, production)"
    },
    "variants": [
      {
        "build-command": "pnpm install",
        "assert-command": "pnpm test:dev",
        "label": "node-nitro-3 (vite, development)"
      },
      {
        "build-command": "pnpm test:build:nitro",
        "assert-command": "pnpm test:nitro-prod",
        "label": "node-nitro-3 (nitro, production)"
      },
      {
        "build-command": "pnpm install",
        "assert-command": "pnpm test:nitro-dev",
        "label": "node-nitro-3 (nitro, development)"
      },
      {
        "build-command": "pnpm test:build:tracing-channel",
        "assert-command": "pnpm test:prod:tracing-channel",
        "label": "node-nitro-3 (vite, production, user-set tracingChannel)"
      }
    ]
  }
}
