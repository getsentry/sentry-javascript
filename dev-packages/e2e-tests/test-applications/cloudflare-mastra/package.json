{
  "name": "cloudflare-mastra",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview --port 4111",
    "typecheck": "tsc --noEmit",
    "clean": "npx rimraf node_modules dist .wrangler pnpm-lock.yaml",
