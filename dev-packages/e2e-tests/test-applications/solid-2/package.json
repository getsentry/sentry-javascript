{
  "name": "solid-2",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:observe": "SOLID_OBSERVE=1 vite build",
    "clean": "npx rimraf node_modules pnpm-lock.yaml dist",
    "dev": "vite --port 3030 --strictPort",
    "preview": "vite preview",
    "test:prod": "TEST_ENV=production playwright test",
    "test:observe": "TEST_ENV=production SOLID_OBSERVE=1 playwright test",
    "test:dev": "TEST_ENV=development playwright test",
    "test:build": "pnpm install && pnpm build",
    "test:build:observe": "pnpm install && pnpm build:observe",
    "test:assert": "pnpm test:prod"
  },
  "dependencies": {
    "@sentry/solid": "file:../../packed/sentry-solid-packed.tgz",
    "@solidjs/router": "^2.0.0",
    "@solidjs/web": "^2.0.0",
    "solid-js": "^2.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sentry/conventions": "0.34.0",
    "@sentry-internal/test-utils": "file:../../packed/sentry-internal-test-utils-packed.tgz",
    "@solidjs/vite-plugin": "^3.0.0",
    "typescript": "^5.4.5",
    "vite": "^8.1.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "sentryTest": {
    "variants": [
      {
        "build-command": "pnpm test:build:observe",
        "assert-command": "pnpm test:observe",
        "label": "solid-2 (observe build)"
      },
      {
        "build-command": "pnpm install",
        "assert-command": "pnpm test:dev",
        "label": "solid-2 (development)"
      }
    ],
    "baseVariant": {
      "build-command": "pnpm test:build",
      "assert-command": "pnpm test:prod",
      "label": "solid-2 (production)"
    }
  }
}
