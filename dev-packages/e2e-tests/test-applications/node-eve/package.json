{
  "name": "node-eve",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#*": "./agent/*"
  },
  "scripts": {
    "build": "EVE_TELEMETRY_DISABLED=1 eve build",
    "dev": "EVE_TELEMETRY_DISABLED=1 eve dev --no-ui --port 3030",
    "start": "EVE_TELEMETRY_DISABLED=1 eve start --port 3030",
    "dev:orchestrion": "NODE_OPTIONS='--import=@sentry/node/import' pnpm dev",
    "start:orchestrion": "NODE_OPTIONS='--import=@sentry/node/import' pnpm start",
    "clean": "npx rimraf node_modules .eve .output pnpm-lock.yaml",
    "test:build": "pnpm install && pnpm build",
    "test:build-orchestrion": "USE_ORCHESTRION=1 pnpm test:build",
    "test:build-0.x": "pnpm install && pnpm add eve@0.63 && pnpm build",
    "test:build-content-off": "SENTRY_GENAI_CONTENT=off pnpm test:build",
    "test:assert": "pnpm test:prod && pnpm test:dev",
    "test:assert-content-off": "SENTRY_GENAI_CONTENT=off pnpm test:assert",
    "test:assert-orchestrion": "USE_ORCHESTRION=1 pnpm test:assert",
    "test:prod": "TEST_ENV=production playwright test",
    "test:dev": "TEST_ENV=development playwright test"
  },
  "dependencies": {
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@sentry/node": "file:../../packed/sentry-node-packed.tgz",
    "ai": "^7.0.172",
    "dataloader": "^2.2.3",
    "eve": "^1.0.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sentry-internal/test-utils": "file:../../packed/sentry-internal-test-utils-packed.tgz",
    "@sentry/conventions": "0.34.0",
    "@types/node": "24.x",
    "typescript": "~5.9.0"
  },
  "engines": {
    "node": "24.x"
  },
  "sentryTest": {
    "optional": true,
    "optionalVariants": [
      {
        "build-command": "pnpm test:build-0.x",
        "assert-command": "pnpm test:assert",
        "label": "node-eve (0.x)"
      },
      {
        "build-command": "pnpm test:build-content-off",
        "assert-command": "pnpm test:assert-content-off",
        "label": "node-eve (content off)"
      },
      {
        "build-command": "pnpm test:build-orchestrion",
        "assert-command": "pnpm test:assert-orchestrion",
        "label": "node-eve (orchestrion)"
      }
    ]
  }
}
