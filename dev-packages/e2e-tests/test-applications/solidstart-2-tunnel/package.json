{
  "name": "solidstart-2-tunnel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "start": "HOST=localhost PORT=3030 node .output/server/index.mjs",
    "clean": "npx rimraf node_modules pnpm-lock.yaml .nitro .output",
