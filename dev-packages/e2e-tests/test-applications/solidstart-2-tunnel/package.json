    "nitro": "3.0.260610-beta"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sentry-internal/test-utils": "file:../../packed/sentry-internal-test-utils-packed.tgz",
    "@solidjs/start": "2.0.2",
    "solid-js": "1.9.14",
    "vite": "^8.1.5"
  },
  "engines": {
    "node": ">=24"
  },
  "sentryTest": {
    "optional": true
  }
}
