{
  "name": "express-5",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "start:bun": "bun dist-bun/main.js",
    "start:deno": "deno run -A --preload=@sentry/deno/import --preload=./src/instrument.ts src/main.ts",
    "start:cloudflare": "wrangler dev --config ./dist-cloudflare/express_5/wrangler.json --port 3030",
    "test": "playwright test",
    "clean": "npx rimraf node_modules pnpm-lock.yaml",
    "test:build": "pnpm install && pnpm build",
    "test:build:bun": "pnpm install && pnpm build && bun ./bun-build.mjs",
    "test:build:cloudflare": "pnpm install && pnpm build && vite build",
    "test:assert": "pnpm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@sentry/bun": "file:../../packed/sentry-bun-packed.tgz",
    "@sentry/cloudflare": "file:../../packed/sentry-cloudflare-packed.tgz",
    "@sentry/deno": "file:../../packed/sentry-deno-packed.tgz",
    "@sentry/node": "file:../../packed/sentry-node-packed.tgz",
    "@trpc/server": "11.8.1",
    "@trpc/client": "11.8.1",
    "@types/express": "^4.17.21",
    "@types/node": "^18.19.1",
    "express": "^5.1.0",
    "mysql": "^2.18.1",
    "typescript": "~5.7.2",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.47.0",
    "@playwright/test": "1.64.1",
    "@sentry-internal/test-utils": "file:../../packed/sentry-internal-test-utils-packed.tgz",
    "@sentry/core": "file:../../packed/sentry-core-packed.tgz",
    "vite": "^8.1.5",
    "wrangler": "^4.120.0"
  },
  "sentryTest": {
    "optionalVariants": [
      {
        "runtime": "bun",
        "build-command": "pnpm test:build:bun",
        "label": "express-5 (bun)"
      },
      {
        "runtime": "deno",
        "label": "express-5 (deno)"
      },
      {
        "runtime": "cloudflare",
        "build-command": "pnpm test:build:cloudflare",
        "label": "express-5 (cloudflare)"
      }
    ]
  }
}
