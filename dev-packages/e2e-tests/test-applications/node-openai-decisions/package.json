{
  "name": "node-openai-decisions",
  "description": "The OpenAI Decisions API as a user runs it: real decisions requests against OpenAI through the openai client and the Vercel AI SDK, and the gen_ai.decide spans they record",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node --import ./dist/instrument.js dist/app.js",
    "test": "playwright test",
    "clean": "npx rimraf node_modules dist pnpm-lock.yaml",
    "test:build": "pnpm install && pnpm build",
    "test:build-latest": "pnpm install && pnpm add openai@latest ai@latest @ai-sdk/openai@latest && pnpm build",
    "test:assert": "pnpm test"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.95",
    "@sentry/node": "file:../../packed/sentry-node-packed.tgz",
    "ai": "7.0.142",
    "express": "^4.21.2",
    "openai": "7.32.0",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sentry-internal/test-utils": "file:../../packed/sentry-internal-test-utils-packed.tgz",
    "@sentry/conventions": "0.30.0",
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "typescript": "~5.9.0"
  },
  "sentryTest": {
    "optional": true,
    "optionalVariants": [
      {
        "build-command": "pnpm test:build-latest",
        "label": "node-openai-decisions (latest)"
      }
    ]
  }
}
