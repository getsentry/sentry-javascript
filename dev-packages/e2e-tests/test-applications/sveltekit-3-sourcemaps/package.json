{
  "name": "sveltekit-3-sourcemaps",
  "description": "E2E test app asserting what the SvelteKit SDK uploads to Sentry and what it leaves behind in `build`.",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node start-mock-sentry-server.mjs & vite build > .tmp_build_stdout 2> .tmp_build_stderr; BUILD_EXIT=$?; kill %1 2>/dev/null; if [ $BUILD_EXIT -ne 0 ]; then cat .tmp_build_stdout; cat .tmp_build_stderr >&2; fi; exit $BUILD_EXIT",
    "clean": "npx rimraf node_modules pnpm-lock.yaml",
    "test:build": "pnpm install && pnpm build",
    "test:assert": "node assert-build.ts",
    "test:build:manual-upload": "pnpm install && E2E_VARIANT=manual-upload pnpm build",
    "test:assert:manual-upload": "E2E_VARIANT=manual-upload pnpm test:assert",
    "test:build:delete-all": "pnpm install && E2E_VARIANT=delete-all pnpm build",
    "test:assert:delete-all": "E2E_VARIANT=delete-all pnpm test:assert"
  },
  "dependencies": {
    "@sentry/sveltekit": "file:../../packed/sentry-sveltekit-packed.tgz"
  },
  "devDependencies": {
    "@sentry-internal/test-utils": "file:../../packed/sentry-internal-test-utils-packed.tgz",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^22.20.0",
    "svelte": "^5.57.1",
    "typescript": "^6.0.0",
    "vite": "^8.0.12"
  },
  "sentryTest": {
    "variants": [
      {
        "build-command": "pnpm test:build:manual-upload",
        "assert-command": "pnpm test:assert:manual-upload",
        "label": "sveltekit-3-sourcemaps (manual upload)"
      },
      {
        "build-command": "pnpm test:build:delete-all",
        "assert-command": "pnpm test:assert:delete-all",
        "label": "sveltekit-3-sourcemaps (delete all)"
      }
    ]
  }
}
