{
  "name": "astro-7",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "start": "node ./dist/server/entry.mjs",
    "test:build": "pnpm install && pnpm build",
    "test:assert": "pnpm test:prod && pnpm test:dev",
    "test:prod": "TEST_ENV=production playwright test",
    "test:dev": "TEST_ENV=development playwright test db",
    "test:build:tunnel": "pnpm install && PUBLIC_E2E_TEST_TUNNEL=1 PUBLIC_E2E_TEST_DSN=http://public@localhost:3031/1337 pnpm build",
    "test:assert:tunnel": "PUBLIC_E2E_TEST_TUNNEL=1 PUBLIC_E2E_TEST_DSN=http://public@localhost:3031/1337 TEST_ENV=production playwright test tunnel"
  },
  "//": "Need to use ioredis 5.10.1 because that's the last version before they support tracing channels",
  "dependencies": {
    "@astrojs/node": "^11.1.4",
    "@playwright/test": "1.64.1",
    "@sentry-internal/test-utils": "file:../../packed/sentry-internal-test-utils-packed.tgz",
    "@sentry/astro": "file:../../packed/sentry-astro-packed.tgz",
    "astro": "^7.2.8",
    "ioredis": "5.10.1",
    "mysql": "^2.18.1"
  },
  "volta": {
    "extends": "../../package.json"
  },
  "sentryTest": {
    "optional": true,
    "variants": [
      {
        "build-command": "pnpm test:build:tunnel",
        "assert-command": "pnpm test:assert:tunnel",
        "label": "astro-7 (tunnel)"
      }
    ]
  }
}
