{
  "name": "node-openai-send-to-sentry",
  "description": "The OpenAI integration as a user runs it: a plain Sentry.init on an express app, real chat, streaming, tool-call, Responses API and embeddings requests through OpenRouter, and the gen_ai spans read back from a real Sentry project",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node --import ./dist/instrument.js dist/app.js",
    "test": "playwright test",
    "clean": "npx rimraf node_modules dist pnpm-lock.yaml",
    "test:build": "pnpm install && pnpm build",
    "test:build-latest": "pnpm install && pnpm add openai@latest && pnpm build",
    "test:assert": "pnpm test"
  },
  "dependencies": {
    "@sentry/node": "file:../../packed/sentry-node-packed.tgz",
    "express": "^4.21.2",
    "openai": "7.5.0"
  },
  "devDependencies": {
    "@playwright/test": "~1.63.0",
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "typescript": "~5.9.0"
  },
  "sentryTest": {
    "optional": true,
    "optionalVariants": [
      {
        "build-command": "pnpm test:build-latest",
        "label": "node-openai-send-to-sentry (latest)"
      }
    ]
  },
  "volta": {
    "node": "24.15.0",
    "extends": "../../package.json"
  }
}
