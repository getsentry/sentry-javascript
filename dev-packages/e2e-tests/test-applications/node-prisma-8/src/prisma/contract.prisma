// use prisma-next

// Regenerate `contract.json`/`contract.d.ts` with `prisma-cli contract emit` and `../../init.sql` from
// `prisma-cli db init` (Node 22.18+). No `DateTime` column: Prisma 8 decodes timestamps into `Temporal`.
model User {
  id    Int     @id @default(autoincrement())
  email String  @unique
  name  String?
}
