{
  "name": "astro-7-tunnel",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "astro build",
    "start": "node ./dist/server/entry.mjs",
    "test:build": "pnpm install && pnpm build",
    "test:build:cloudflare-workers": "pnpm install && rm sentry.server.config.js && pnpm build",
    "test:build:cloudflare-pages": "pnpm install && pnpm add astro@^5.17.1 @astrojs/cloudflare@^12.6.12 && cp wrangler.pages.jsonc wrangler.jsonc && rm src/pages/static.astro && E2E_TEST_CF_PAGES=1 pnpm build",
    "test:assert": "pnpm test:prod && TEST_ENV=development playwright test",
    "test:prod": "TEST_ENV=production playwright test"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.8",
    "@astrojs/node": "^11.1.4",
    "@sentry/astro": "file:../../packed/sentry-astro-packed.tgz",
    "@sentry/cloudflare": "file:../../packed/sentry-cloudflare-packed.tgz",
    "astro": "^7.4.0",
    "wrangler": "^4.125.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sentry-internal/test-utils": "file:../../packed/sentry-internal-test-utils-packed.tgz"
  },
  "sentryTest": {
    "variants": [
      {
        "runtime": "cloudflare",
        "build-command": "pnpm test:build:cloudflare-workers",
        "assert-command": "pnpm test:prod",
        "label": "astro-7-tunnel (cloudflare workers)"
      },
      {
        "runtime": "cloudflare",
        "build-command": "pnpm test:build:cloudflare-pages",
        "assert-command": "E2E_TEST_CF_PAGES=1 pnpm test:prod",
        "label": "astro-7-tunnel (astro 5, cloudflare pages)"
      }
    ]
  }
}
