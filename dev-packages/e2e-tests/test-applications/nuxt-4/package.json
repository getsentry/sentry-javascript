{
  "name": "nuxt-4",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "start": "node .output/server/index.mjs",
    "start:bun": "bun .output/server/index.mjs",
    "start:deno": "deno run -A .output/server/index.mjs",
    "start:cloudflare": "wrangler dev --port 3030",
    "start:import": "node --import ./.output/server/sentry.server.config.mjs .output/server/index.mjs",
    "clean": "npx nuxi cleanup",
    "test": "playwright test",
    "test:prod": "TEST_ENV=production playwright test",
    "test:dev": "TEST_ENV=development playwright test environment db-drivers",
    "test:build": "pnpm install && node ./scripts/build-with-prerender-event-sink.mjs",
    "test:build-canary": "pnpm add nuxt@npm:nuxt-nightly@latest && pnpm add nitropack@npm:nitropack-nightly@latest && pnpm install --force && node ./scripts/build-with-prerender-event-sink.mjs",
    "test:assert": "pnpm test:prod && pnpm test:dev",
    "test:prod:import": "TEST_ENV=production-import playwright test",
    "test:build:cloudflare": "rm sentry.server.config.ts && pnpm test:build"
  },
  "//": "Pin ioredis to 5.10.1 because that's the last version before it publishes its own diagnostics channels",
  "dependencies": {
    "@pinia/nuxt": "^0.5.5",
    "@sentry/bun": "file:../../packed/sentry-bun-packed.tgz",
    "@sentry/cloudflare": "file:../../packed/sentry-cloudflare-packed.tgz",
    "@sentry/deno": "file:../../packed/sentry-deno-packed.tgz",
    "@sentry/nuxt": "file:../../packed/sentry-nuxt-packed.tgz",
    "ioredis": "5.10.1",
    "mongoose": "^9.10.2",
    "mysql": "^2.18.1",
    "nuxt": "^4.6.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sentry/conventions": "0.33.0",
    "@sentry-internal/test-utils": "file:../../packed/sentry-internal-test-utils-packed.tgz",
    "wrangler": "^4.72.0"
  },
  "sentryTest": {
    "variants": [
      {
        "build-command": "pnpm install",
        "assert-command": "pnpm test:dev",
        "label": "nuxt-4 (development)"
      },
      {
        "build-command": "E2E_TEST_VITE_SERVER=true pnpm test:build",
        "assert-command": "E2E_TEST_VITE_SERVER=true pnpm test:prod",
        "label": "nuxt-4 (Vite server)"
      },
      {
        "runtime": "bun",
        "assert-command": "pnpm test:prod",
        "label": "nuxt-4 (bun)"
      },
      {
        "runtime": "deno",
        "deno-version": "v2.9.0",
        "assert-command": "pnpm test:prod",
        "label": "nuxt-4 (deno)"
      },
      {
        "runtime": "cloudflare",
        "build-command": "pnpm test:build:cloudflare",
        "assert-command": "pnpm test:prod",
        "label": "nuxt-4 (cloudflare)"
      },
      {
        "build-command": "E2E_TEST_TRACE_LIFECYCLE=static pnpm test:build",
        "assert-command": "E2E_TEST_TRACE_LIFECYCLE=static pnpm test:prod",
        "label": "nuxt-4 (production, static trace lifecycle)"
      }
    ],
    "canaryVariants": [
      {
        "build-command": "pnpm test:build-canary",
        "label": "nuxt-4 (canary)"
      },
      {
        "build-command": "E2E_TEST_TRACE_LIFECYCLE=static pnpm test:build-canary",
        "assert-command": "E2E_TEST_TRACE_LIFECYCLE=static pnpm test:prod",
        "label": "nuxt-4 (canary, static trace lifecycle)"
      }
    ],
    "baseVariant": {
      "assert-command": "pnpm test:prod"
    }
  }
}
