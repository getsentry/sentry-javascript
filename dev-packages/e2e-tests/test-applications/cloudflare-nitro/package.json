{
  "name": "cloudflare-nitro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "preview": "wrangler dev --var \"E2E_TEST_DSN:$E2E_TEST_DSN\" --port 3030 --log-level=$(test $CI && echo 'none' || echo 'log')",
    "test": "playwright test",
    "clean": "npx rimraf node_modules pnpm-lock.yaml .output .nitro .wrangler",
    "test:build": "pnpm install && pnpm build",
    "test:assert": "pnpm test"
  },
  "dependencies": {
    "@sentry/cloudflare": "file:../../packed/sentry-cloudflare-packed.tgz",
    "@sentry/server-utils": "file:../../packed/sentry-server-utils-packed.tgz"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260727.1",
    "@playwright/test": "~1.63.0",
    "@sentry-internal/test-utils": "link:../../../test-utils",
    "nitro": "^3.0.260522-beta",
    "rolldown": "latest",
    "vite": "latest",
    "wrangler": "^4.114.0"
  },
  "pnpm": {
    "overrides": {
      "unstorage": "2.0.0-alpha.7"
    }
  },
  "volta": {
    "extends": "../../package.json"
  }
}
