{
  "name": "solidstart-e2e-testapp",
  "version": "0.0.0",
  "scripts": {
    "clean": "pnpx rimraf node_modules pnpm-lock.yaml .vinxi .output",
    "build": "node start-mock-sentry-server.mjs & vinxi build > .tmp_build_stdout 2> .tmp_build_stderr; BUILD_EXIT=$?; kill %1 2>/dev/null; if [ $BUILD_EXIT -ne 0 ]; then cat .tmp_build_stdout; cat .tmp_build_stderr >&2; fi; exit $BUILD_EXIT",
    "dev": "vinxi dev",
    "preview": "HOST=localhost PORT=3030 vinxi start",
    "start:import": "HOST=localhost PORT=3030 node --import ./.output/server/instrument.server.mjs .output/server/index.mjs",
    "test:prod": "TEST_ENV=production playwright test",
    "test:build": "pnpm install && pnpm build",
    "test:assert": "node assert-build.ts && pnpm test:prod && pnpm test:dev",
    "test:dev": "TEST_ENV=development playwright test db",
    "test:build:no-upload": "pnpm install && E2E_NO_UPLOAD=1 pnpm build",
    "test:assert:no-upload": "E2E_NO_UPLOAD=1 node assert-build.ts",
    "test:build:manual-upload": "pnpm install && E2E_VARIANT=manual-upload pnpm build",
    "test:assert:manual-upload": "E2E_VARIANT=manual-upload node assert-build.ts",
    "test:build:delete-all": "pnpm install && E2E_VARIANT=delete-all pnpm build",
    "test:assert:delete-all": "E2E_VARIANT=delete-all node assert-build.ts"
  },
  "type": "module",
  "dependencies": {
    "@sentry/solidstart": "file:../../packed/sentry-solidstart-packed.tgz",
    "ioredis": "5.10.1",
    "mysql": "^2.18.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sentry-internal/test-utils": "file:../../packed/sentry-internal-test-utils-packed.tgz",
    "@sentry/conventions": "0.37.0",
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^1.0.0",
    "@solidjs/start": "^1.0.2",
    "@testing-library/jest-dom": "^6.4.2",
    "solid-js": "1.9.5",
    "typescript": "^5.4.5",
    "vinxi": "^0.5.11",
    "vite": "^6.4.4"
  },
  "sentryTest": {
    "variants": [
      {
        "build-command": "E2E_TEST_INJECT_MODE=top-level-import pnpm test:build",
        "assert-command": "E2E_TEST_INJECT_MODE=top-level-import pnpm test:prod",
        "label": "solidstart (top-level-import)"
      },
      {
        "build-command": "E2E_TEST_INJECT_MODE=experimental_dynamic-import pnpm test:build",
        "assert-command": "E2E_TEST_INJECT_MODE=experimental_dynamic-import pnpm test:prod",
        "label": "solidstart (dynamic-import)"
      },
      {
        "build-command": "VITE_E2E_TEST_TRACE_LIFECYCLE=static pnpm test:build",
        "assert-command": "E2E_TEST_TRACE_LIFECYCLE=static pnpm test:prod",
        "label": "solidstart (static trace lifecycle)"
      },
      {
        "build-command": "pnpm test:build:no-upload",
        "assert-command": "pnpm test:assert:no-upload",
        "label": "solidstart (no upload)"
      },
      {
        "build-command": "pnpm test:build:manual-upload",
        "assert-command": "pnpm test:assert:manual-upload",
        "label": "solidstart (manual upload)"
      },
      {
        "build-command": "pnpm test:build:delete-all",
        "assert-command": "pnpm test:assert:delete-all",
        "label": "solidstart (delete all)"
      }
    ]
  }
}
