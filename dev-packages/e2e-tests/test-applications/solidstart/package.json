{
  "name": "solidstart-e2e-testapp",
  "version": "0.0.0",
  "scripts": {
    "clean": "pnpx rimraf node_modules pnpm-lock.yaml .vinxi .output",
    "build": "vinxi build",
    "dev": "vinxi dev",
    "preview": "HOST=localhost PORT=3030 vinxi start",
    "start:import": "HOST=localhost PORT=3030 node --import ./.output/server/instrument.server.mjs .output/server/index.mjs",
    "test:prod": "TEST_ENV=production playwright test",
    "test:build": "pnpm install && pnpm build",
    "test:assert": "pnpm test:prod && pnpm test:dev",
    "test:dev": "TEST_ENV=development playwright test db",
    "test:build:tunnel": "pnpm install && E2E_TEST_TUNNEL=1 pnpm build",
    "test:build:tunnel-basepath": "pnpm install && E2E_TEST_TUNNEL=1 E2E_TEST_BASE_PATH=/app pnpm build",
    "test:assert:tunnel": "E2E_TEST_TUNNEL=1 E2E_TEST_DSN=http://public@localhost:3031/1337 TEST_ENV=production playwright test tunnel",
    "test:assert:tunnel-basepath": "E2E_TEST_TUNNEL=1 E2E_TEST_BASE_PATH=/app E2E_TEST_DSN=http://public@localhost:3031/1337 TEST_ENV=production playwright test tunnel"
  },
  "type": "module",
  "dependencies": {
    "@sentry/solidstart": "file:../../packed/sentry-solidstart-packed.tgz",
    "ioredis": "5.10.1",
    "mysql": "^2.18.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sentry-internal/test-utils": "file:../../packed/sentry-internal-test-utils-packed.tgz",
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^1.0.0",
    "@solidjs/start": "^1.0.2",
    "@solidjs/testing-library": "^0.8.7",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/user-event": "^14.5.2",
    "jsdom": "^24.0.0",
    "solid-js": "1.9.5",
    "typescript": "^5.4.5",
    "vinxi": "^0.4.0",
    "vite": "^5.4.11",
    "vite-plugin-solid": "^2.11.6"
  },
  "volta": {
    "extends": "../../package.json"
  },
  "sentryTest": {
    "variants": [
      {
        "build-command": "pnpm test:build:tunnel",
        "assert-command": "pnpm test:assert:tunnel",
        "label": "solidstart (tunnel)"
      },
      {
        "build-command": "pnpm test:build:tunnel-basepath",
        "assert-command": "pnpm test:assert:tunnel-basepath",
        "label": "solidstart (tunnel-basepath)"
      }
    ]
  }
}
