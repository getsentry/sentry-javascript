{
  "name": "nuxt-5-tunnel",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "start:cloudflare": "wrangler dev --port 3030",
    "clean": "npx nuxi cleanup",
    "test:build": "pnpm install && pnpm build",
    "test:assert": "TEST_ENV=production playwright test && TEST_ENV=development playwright test"
  },
  "//": [
    "Nuxt v5 is only on the Nuxt nightlies, like the `nuxt-5` app.",
    "`ofetch` is a dependency of `nuxt`, which Nuxt's virtual `fetch.server.mjs` can't resolve from the app, see `nuxt-5`."
  ],
  "dependencies": {
    "@sentry/cloudflare": "file:../../packed/sentry-cloudflare-packed.tgz",
    "@sentry/nuxt": "file:../../packed/sentry-nuxt-packed.tgz",
    "nuxt": "npm:nuxt-nightly@5x",
    "ofetch": "^2.0.0-alpha.3",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sentry-internal/test-utils": "file:../../packed/sentry-internal-test-utils-packed.tgz",
    "wrangler": "^4.72.0"
  },
  "sentryTest": {
    "optional": true,
    "optionalVariants": [
      {
        "runtime": "cloudflare",
        "build-command": "rm sentry.server.config.ts && pnpm test:build",
        "assert-command": "TEST_ENV=production pnpm exec playwright test",
        "label": "nuxt-5-tunnel (cloudflare)"
      }
    ]
  }
}
