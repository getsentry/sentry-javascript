{
  "name": "astro-5-cf-workers",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev --port 3030",
    "preview:server-config": "wrangler dev --config wrangler.server-config.jsonc --port 3030",
    "test:build": "pnpm install && pnpm build",
    "test:assert": "TEST_ENV=production playwright test",
    "test:build:server-config": "pnpm install && PUBLIC_E2E_TEST_SERVER_CONFIG=1 pnpm build",
    "test:assert:server-config": "PUBLIC_E2E_TEST_SERVER_CONFIG=1 TEST_ENV=production playwright test server-config"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.12",
    "@playwright/test": "1.64.1",
    "@sentry-internal/test-utils": "file:../../packed/sentry-internal-test-utils-packed.tgz",
    "@sentry/astro": "file:../../packed/sentry-astro-packed.tgz",
    "@sentry/cloudflare": "file:../../packed/sentry-cloudflare-packed.tgz",
    "astro": "^5.17.1"
  },
  "devDependencies": {
    "wrangler": "^4.63.0"
  },
  "sentryTest": {
    "variants": [
      {
        "build-command": "pnpm test:build:server-config",
        "assert-command": "pnpm test:assert:server-config",
        "label": "astro-5-cf-workers (server-config)"
      }
    ]
  }
}
