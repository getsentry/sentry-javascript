{
  "name": "nitro-3",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "start": "PORT=3030 NODE_OPTIONS='--import ./instrument.mjs' node .output/server/index.mjs",
    "clean": "npx rimraf node_modules pnpm-lock.yaml .output",
    "test": "playwright test",
    "test:build": "pnpm install && pnpm build",
    "test:assert": "pnpm test",
    "test:build:tunnel-basepath": "pnpm install && E2E_TEST_TUNNEL=1 E2E_TEST_BASE_PATH=/app pnpm build",
    "test:assert:tunnel-basepath": "E2E_TEST_TUNNEL=1 E2E_TEST_BASE_PATH=/app playwright test tunnel",
    "test:assert:tunnel-basepath-dev": "TEST_ENV=development E2E_TEST_TUNNEL=1 E2E_TEST_BASE_PATH=/app playwright test tunnel"
  },
  "dependencies": {
    "@sentry/browser": "latest || *",
    "@sentry/nitro": "latest || *"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sentry-internal/test-utils": "file:../../packed/sentry-internal-test-utils-packed.tgz",
    "@sentry/conventions": "0.30.0",
    "@sentry/core": "latest || *",
    "nitro": "^3.0.260522-beta",
    "rolldown": "latest",
    "vite": "latest"
  },
  "sentryTest": {
    "variants": [
      {
        "build-command": "pnpm test:build:tunnel-basepath",
        "assert-command": "pnpm test:assert:tunnel-basepath",
        "label": "nitro-3 (tunnel-basepath)"
      },
      {
        "build-command": "pnpm install",
        "assert-command": "pnpm test:assert:tunnel-basepath-dev",
        "label": "nitro-3 (tunnel-basepath-dev)"
      }
    ]
  }
}
