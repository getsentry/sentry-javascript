{
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "node start-mock-sentry-server.mjs & remix vite:build > .tmp_build_stdout 2> .tmp_build_stderr; BUILD_EXIT=$?; kill %1 2>/dev/null; cat .tmp_build_stdout .tmp_build_stderr; exit $BUILD_EXIT",
    "clean": "npx rimraf node_modules pnpm-lock.yaml",
    "test:build": "pnpm install && pnpm build",
    "test:build:no-upload": "pnpm install && E2E_NO_UPLOAD=1 pnpm build",
    "test:assert": "pnpm tsx assert-build.ts",
    "test:assert:no-upload": "E2E_NO_UPLOAD=1 pnpm test:assert",
    "test:build:manual-upload": "pnpm install && E2E_VARIANT=manual-upload pnpm build",
    "test:assert:manual-upload": "E2E_VARIANT=manual-upload pnpm test:assert",
    "test:build:delete-all": "pnpm install && E2E_VARIANT=delete-all pnpm build",
    "test:assert:delete-all": "E2E_VARIANT=delete-all pnpm test:assert"
  },
  "dependencies": {
    "@sentry/remix": "file:../../packed/sentry-remix-packed.tgz",
    "@remix-run/node": "2.17.4",
    "@remix-run/react": "2.17.4",
    "@remix-run/serve": "2.17.4",
    "isbot": "^3.6.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@remix-run/dev": "2.17.4",
    "@sentry-internal/test-utils": "file:../../packed/sentry-internal-test-utils-packed.tgz",
    "@types/node": "^20",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.34",
    "tsx": "^4.23.0",
    "typescript": "^5.1.6",
    "vite": "^5.4.11"
  },
  "sentryTest": {
    "variants": [
      {
        "build-command": "pnpm test:build:no-upload",
        "assert-command": "pnpm test:assert:no-upload",
        "label": "remix-sourcemaps (no upload)"
      },
      {
        "build-command": "pnpm test:build:manual-upload",
        "assert-command": "pnpm test:assert:manual-upload",
        "label": "remix-sourcemaps (manual upload)"
      },
      {
        "build-command": "pnpm test:build:delete-all",
        "assert-command": "pnpm test:assert:delete-all",
        "label": "remix-sourcemaps (delete all)"
      }
    ]
  }
}
