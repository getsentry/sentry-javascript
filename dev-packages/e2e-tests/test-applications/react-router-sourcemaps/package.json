{
  "name": "react-router-sourcemaps",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.3.0",
    "@react-router/node": "^8.3.0",
    "@react-router/serve": "^8.3.0",
    "@sentry/react-router": "file:../../packed/sentry-react-router-packed.tgz",
    "isbot": "^5.1.17"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/node": "^20",
    "@react-router/dev": "^8.3.0",
    "@playwright/test": "1.64.1",
    "@sentry-internal/test-utils": "file:../../packed/sentry-internal-test-utils-packed.tgz",
    "tsx": "^4.23.0",
    "typescript": "^5.6.3",
    "vite": "^7.3.2"
  },
  "scripts": {
    "build": "node start-mock-sentry-server.mjs & SENTRY_URL=http://localhost:3032 react-router build > .tmp_build_stdout 2> .tmp_build_stderr; BUILD_EXIT=$?; kill %1 2>/dev/null; exit $BUILD_EXIT",
    "clean": "npx rimraf node_modules pnpm-lock.yaml",
    "test:build": "pnpm install && pnpm build",
    "test:assert": "pnpm tsx assert-build.ts",
    "test:build:manual-upload": "pnpm install && E2E_VARIANT=manual-upload pnpm build",
    "test:assert:manual-upload": "pnpm tsx assert-manual-upload.ts",
    "test:build:delete-all": "pnpm install && E2E_VARIANT=delete-all pnpm build",
    "test:assert:delete-all": "E2E_VARIANT=delete-all pnpm test:assert"
  },
  "sentryTest": {
    "variants": [
      {
        "build-command": "pnpm test:build:manual-upload",
        "assert-command": "pnpm test:assert:manual-upload",
        "label": "react-router-sourcemaps (manual upload)"
      },
      {
        "build-command": "pnpm test:build:delete-all",
        "assert-command": "pnpm test:assert:delete-all",
        "label": "react-router-sourcemaps (delete all)"
      }
    ]
  }
}
