{
  "name": "node-express-mcp-v2-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "start": "node --import ./instrument.mjs dist/app.js",
    "test": "playwright test",
    "clean": "npx rimraf node_modules pnpm-lock.yaml",
    "test:build": "pnpm install && pnpm build",
    "test:build-mcp-sdk-otel": "pnpm install && pnpm add --config.block-exotic-subdeps=false https://pkg.pr.new/modelcontextprotocol/typescript-sdk/@modelcontextprotocol/server@919bb8e https://pkg.pr.new/modelcontextprotocol/typescript-sdk/@modelcontextprotocol/node@919bb8e @opentelemetry/api@^1.9.0 && pnpm add --config.block-exotic-subdeps=false -D https://pkg.pr.new/modelcontextprotocol/typescript-sdk/@modelcontextprotocol/client@919bb8e && pnpm build",
    "test:assert": "pnpm test",
    "test:assert-mcp-sdk-otel": "MCP_SDK_OTEL=1 pnpm test"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@sentry/node": "file:../../packed/sentry-node-packed.tgz",
    "@types/express": "^4.17.21",
    "@types/node": "^18.19.1",
    "express": "^4.21.2",
    "typescript": "~5.0.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@playwright/test": "1.64.1",
    "@sentry-internal/test-utils": "file:../../packed/sentry-internal-test-utils-packed.tgz"
  },
  "type": "module",
  "sentryTest": {
    "optional": true,
    "optionalVariants": [
      {
        "build-command": "pnpm test:build-mcp-sdk-otel",
        "assert-command": "pnpm test:assert-mcp-sdk-otel",
        "label": "node-express-mcp-v2 (MCP SDK OpenTelemetry)"
      }
    ]
  }
}
