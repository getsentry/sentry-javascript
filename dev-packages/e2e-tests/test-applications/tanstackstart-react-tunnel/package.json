{
  "name": "tanstackstart-react-tunnel",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "start": "PORT=3030 node .output/server/index.mjs",
    "clean": "npx rimraf node_modules pnpm-lock.yaml .output",
    "test:build": "pnpm install && pnpm build",
    "test:assert": "TEST_ENV=production playwright test && TEST_ENV=development playwright test"
  },
  "dependencies": {
    "@sentry/tanstackstart-react": "file:../../packed/sentry-tanstackstart-react-packed.tgz",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.5",
    "nitro": "3.0.260903-beta",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sentry-internal/test-utils": "file:../../packed/sentry-internal-test-utils-packed.tgz",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "vite": "8.3.4"
  },
  "sentryTest": {
    "variants": [
      {
        "label": "tanstackstart-react-tunnel (static)",
        "build-command": "E2E_TEST_TUNNEL_ROUTE=/app/monitor pnpm test:build",
        "assert-command": "E2E_TEST_TUNNEL_ROUTE=/app/monitor pnpm test:assert"
      }
    ]
  }
}
