{
  "name": "react-router-cross-usage",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@sentry/react": "file:../../packed/sentry-react-packed.tgz",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "^8.0.0",
    "react-scripts": "5.0.1",
    "typescript": "^5.6.3"
  },
  "scripts": {
    "build": "react-scripts build",
    "start": "serve -s build",
    "test": "playwright test",
    "clean": "npx rimraf node_modules pnpm-lock.yaml",
    "test:build": "pnpm install && pnpm build",
    "test:build-canary": "pnpm install && pnpm add react@canary react-dom@canary && pnpm build",
    "test:build-react-router-7": "pnpm install && pnpm add react-router@7.6.0 react@18.2.0 react-dom@18.2.0 @types/react@18.0.0 @types/react-dom@18.0.0 && pnpm build",
    "test:assert": "pnpm test"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sentry-internal/test-utils": "file:../../packed/sentry-internal-test-utils-packed.tgz",
    "serve": "14.0.1"
  },
  "sentryTest": {
    "baseVariant": {
      "label": "react-router-cross-usage (react-router@8)"
    },
    "variants": [
      {
        "build-command": "pnpm test:build-react-router-7",
        "label": "react-router-cross-usage (react-router@7)"
      }
    ]
  }
}
