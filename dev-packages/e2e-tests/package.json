{
  "name": "@sentry-internal/e2e-tests",
  "version": "11.10.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "lint:fix": "oxlint . --fix --type-aware",
    "lint": "oxlint . --type-aware",
    "test:e2e": "run-s test:prepare test:validate test:run",
    "test:run": "node run.mjs",
    "test:prepare": "node prepare.mjs",
    "test:validate": "node validate-packed-tarball-setup.mjs",
    "clean": "rimraf tmp node_modules packed && pnpm run clean:test-applications && pnpm run clean:pnpm",
    "ci:build-matrix": "node ./lib/getTestMatrix.mjs",
    "ci:build-matrix-optional": "node ./lib/getTestMatrix.mjs --optional=true",
    "ci:build-matrix-canary": "node ./lib/getTestMatrix.mjs --canary=true",
    "ci:copy-to-temp": "node ./ciCopyToTemp.mjs",
    "ci:pnpm-overrides": "node ./ciPnpmOverrides.mjs",
    "clean:test-applications": "rimraf --glob test-applications/**/{node_modules,dist,build,.next,.nuxt,.sveltekit,.react-router,.astro,.output,pnpm-lock.yaml,.last-run.json,test-results,.angular}",
    "clean:pnpm": "pnpm store prune"
  },
  "devDependencies": {
    "eslint-plugin-regexp": "^3.1.0",
    "rimraf": "^6.1.3"
  }
}
