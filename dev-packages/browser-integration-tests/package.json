{
  "name": "@sentry-internal/browser-integration-tests",
  "version": "11.10.0",
  "main": "index.js",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0 <22.0.0 || >=22.12.0 <23.0.0 || >=23.2.0"
  },
  "private": true,
  "scripts": {
    "clean": "rimraf -g suites/**/dist loader-suites/**/dist tmp",
    "install-browsers": "[[ -z \"$SKIP_PLAYWRIGHT_BROWSER_INSTALL\" ]] && npx playwright install --with-deps || echo 'Skipping browser installation'",
    "lint": "oxlint . --type-aware",
    "lint:fix": "oxlint . --fix --type-aware",
    "lint:types": "tsc --noEmit",
    "postinstall": "pnpm run install-browsers",
    "pretest": "pnpm clean && pnpm run lint:types",
    "test": "pnpm run test:all --project='chromium'",
    "test:all": "npx playwright test -c playwright.browser.config.ts",
    "test:bundle": "PW_BUNDLE=bundle pnpm run test",
    "test:bundle:min": "PW_BUNDLE=bundle_min pnpm run test",
    "test:bundle:logs_metrics": "PW_BUNDLE=bundle_logs_metrics pnpm run test",
    "test:bundle:logs_metrics:min": "PW_BUNDLE=bundle_logs_metrics_min pnpm run test",
    "test:bundle:logs_metrics:debug_min": "PW_BUNDLE=bundle_logs_metrics_debug_min pnpm run test",
    "test:bundle:replay": "PW_BUNDLE=bundle_replay pnpm run test",
    "test:bundle:replay:min": "PW_BUNDLE=bundle_replay_min pnpm run test",
    "test:bundle:replay_logs_metrics": "PW_BUNDLE=bundle_replay_logs_metrics pnpm run test",
    "test:bundle:replay_logs_metrics:min": "PW_BUNDLE=bundle_replay_logs_metrics_min pnpm run test",
    "test:bundle:replay_logs_metrics:debug_min": "PW_BUNDLE=bundle_replay_logs_metrics_debug_min pnpm run test",
    "test:bundle:tracing": "PW_BUNDLE=bundle_tracing pnpm run test",
    "test:bundle:tracing:min": "PW_BUNDLE=bundle_tracing_min pnpm run test",
    "test:bundle:tracing_logs_metrics": "PW_BUNDLE=bundle_tracing_logs_metrics pnpm run test",
    "test:bundle:tracing_logs_metrics:min": "PW_BUNDLE=bundle_tracing_logs_metrics_min pnpm run test",
    "test:bundle:tracing_logs_metrics:debug_min": "PW_BUNDLE=bundle_tracing_logs_metrics_debug_min pnpm run test",
    "test:bundle:tracing_replay": "PW_BUNDLE=bundle_tracing_replay pnpm run test",
    "test:bundle:tracing_replay:min": "PW_BUNDLE=bundle_tracing_replay_min pnpm run test",
    "test:bundle:tracing_replay_logs_metrics": "PW_BUNDLE=bundle_tracing_replay_logs_metrics pnpm run test",
    "test:bundle:tracing_replay_logs_metrics:min": "PW_BUNDLE=bundle_tracing_replay_logs_metrics_min pnpm run test",
    "test:bundle:tracing_replay_logs_metrics:debug_min": "PW_BUNDLE=bundle_tracing_replay_logs_metrics_debug_min pnpm run test",
    "test:bundle:full": "PW_BUNDLE=bundle_tracing_replay_feedback_logs_metrics pnpm run test",
    "test:bundle:full:min": "PW_BUNDLE=bundle_tracing_replay_feedback_logs_metrics_min pnpm run test",
    "test:bundle:tracing_replay_feedback_logs_metrics": "PW_BUNDLE=bundle_tracing_replay_feedback_logs_metrics pnpm run test",
    "test:bundle:tracing_replay_feedback_logs_metrics:min": "PW_BUNDLE=bundle_tracing_replay_feedback_logs_metrics_min pnpm run test",
    "test:bundle:tracing_replay_feedback_logs_metrics:debug_min": "PW_BUNDLE=bundle_tracing_replay_feedback_logs_metrics_debug_min pnpm run test",
    "test:cjs": "PW_BUNDLE=cjs pnpm run test",
    "test:esm": "PW_BUNDLE=esm pnpm run test",
    "test:loader": "npx playwright test  -c playwright.loader.config.ts --project='chromium'",
    "test:loader:base": "PW_BUNDLE=loader_base pnpm run test:loader",
    "test:loader:eager": "PW_BUNDLE=loader_eager pnpm run test:loader",
    "test:loader:tracing": "PW_BUNDLE=loader_tracing pnpm run test:loader",
    "test:loader:replay": "PW_BUNDLE=loader_replay pnpm run test:loader",
    "test:loader:replay_buffer": "PW_BUNDLE=loader_replay_buffer pnpm run test:loader",
    "test:loader:full": "PW_BUNDLE=loader_tracing_replay pnpm run test:loader",
    "test:loader:debug": "PW_BUNDLE=loader_debug pnpm run test:loader",
    "test:update-snapshots": "pnpm run test:all --update-snapshots",
    "test:detect-flaky": "tsx scripts/detectFlakyTests.ts"
  },
  "dependencies": {
    "@babel/core": "^7.29.6",
    "@babel/preset-typescript": "^7.16.7",
    "@playwright/test": "1.64.1",
    "@sentry/rrweb": "2.45.0",
    "@sentry/browser": "11.10.0",
    "@sentry/replay": "11.10.0",
    "@sentry/opentelemetry": "11.10.0",
    "@sentry/conventions": "0.30.0",
    "@supabase/supabase-js": "2.109.0",
    "axios": "1.20.0",
    "babel-loader": "^10.1.1",
    "fflate": "0.8.3",
    "html-webpack-plugin": "^5.5.0",
    "webpack": "^5.112.2"
  },
  "devDependencies": {
    "@sentry/browser-utils": "11.10.0",
    "@sentry/core": "11.10.0",
    "@sentry/replay-canvas": "11.10.0",
    "@sentry/rrweb-types": "^2.45.0",
    "@sentry/wasm": "11.10.0",
    "@types/node": "^20.19.0",
    "eslint-plugin-regexp": "^3.1.0",
    "glob": "^13.0.6"
  }
}
