{
  "name": "@sentry-internal/bundler-plugin-integration-tests",
  "version": "11.12.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "test": "node setup.mjs && vitest run --pool threads --test-timeout=10000",
    "check:types": "tsc --project ./tsconfig.json --noEmit",
    "clean": "pnpm run clean:build",
    "clean:all": "pnpm run \"/^(clean|clean:deps)$/\"",
    "clean:build": "node ../../scripts/rm.mjs ./fixtures/*/out",
    "clean:deps": "node ../../scripts/rm.mjs node_modules"
  },
  "devDependencies": {
    "@sentry/bundler-plugins": "11.12.0",
    "sentry": "^0.49.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12"
  }
}
