{
  "name": "@sentry/browser",
  "version": "11.12.0",
  "description": "Official Sentry SDK for browsers",
  "repository": "git://github.com/getsentry/sentry-javascript.git",
  "homepage": "https://github.com/getsentry/sentry-javascript/tree/master/packages/browser",
  "author": "Sentry",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0 <22.0.0 || >=22.12.0 <23.0.0 || >=23.2.0"
  },
  "files": [
    "/build/npm"
  ],
  "main": "build/npm/cjs/prod/index.js",
  "module": "build/npm/esm/prod/index.js",
  "types": "build/npm/types/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./build/npm/types/index.d.ts",
      "react-native": "./build/npm/esm/prod/index.js",
      "development": {
        "import": "./build/npm/esm/dev/index.js",
        "require": "./build/npm/cjs/dev/index.js"
      },
      "production": {
        "import": "./build/npm/esm/prod/index.js",
        "require": "./build/npm/cjs/prod/index.js"
      },
      "default": {
        "import": "./build/npm/esm/prod/index.js",
        "require": "./build/npm/cjs/prod/index.js"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@sentry/browser-utils": "11.12.0",
    "@sentry/conventions": "^0.32.0",
    "@sentry/feedback": "11.12.0",
    "@sentry/replay": "11.12.0",
    "@sentry/replay-canvas": "11.12.0",
    "@sentry/core": "11.12.0"
  },
  "devDependencies": {
    "@sentry-internal/integration-shims": "11.12.0",
    "@sentry-internal/rollup-utils": "11.12.0",
    "fake-indexeddb": "^6.2.7"
  },
  "scripts": {
    "build": "pnpm run \"/^build:(transpile|bundle|types)$/\"",
    "build:dev": "pnpm run \"/^build:(transpile|types)$/\"",
    "build:bundle": "rolldown -c rollup.bundle.config.mjs",
    "build:transpile": "rolldown -c rollup.npm.config.mjs",
    "build:types": "tsc -p tsconfig.types.json",
    "build:watch": "pnpm run --workspace-concurrency=Infinity \"/^build:(transpile|bundle):watch$/\"",
    "build:dev:watch": "pnpm run build:transpile:watch",
    "build:bundle:watch": "rolldown -c rollup.bundle.config.mjs --watch",
    "build:transpile:watch": "rolldown -c rollup.npm.config.mjs --watch",
    "build:tarball": "pnpm pack",
    "clean": "node ../../scripts/rm.mjs build coverage .rpt2_cache sentry-browser-*.tgz",
    "lint:fix": "oxlint . --fix --type-aware",
    "lint": "oxlint . --type-aware",
    "lint:types": "oxlint src --type-aware --type-check",
    "lint:es-compatibility": "es-check es2020 ./build/{bundles,npm/cjs/prod}/*.js && es-check es2020 ./build/npm/esm/prod/*.js --module",
    "size:check": "cat build/bundles/bundle.min.js | gzip -9 | wc -c | awk '{$1=$1/1024; print \"ES2017: \",$1,\"kB\";}'",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "yalc:publish": "pnpm dlx yalc publish --push --sig"
  },
  "sideEffects": false
}
