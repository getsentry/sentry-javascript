{
  "name": "@sentry/replay",
  "version": "11.12.0",
  "description": "User replays for Sentry",
  "main": "build/npm/cjs/index.js",
  "module": "build/npm/esm/index.js",
  "types": "build/npm/types/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    "./worker-bundler": {
      "react-native": "./build/npm/esm/worker-bundler.js",
      "import": {
        "types": "./build/npm/types/worker-bundler.d.ts",
        "default": "./build/npm/esm/worker-bundler.js"
      },
      "require": {
        "types": "./build/npm/types/worker-bundler.d.ts",
        "default": "./build/npm/cjs/worker-bundler.js"
      }
    },
    ".": {
      "react-native": "./build/npm/esm/index.js",
      "import": {
        "types": "./build/npm/types/index.d.ts",
        "default": "./build/npm/esm/index.js"
      },
      "require": {
        "types": "./build/npm/types/index.d.ts",
        "default": "./build/npm/cjs/index.js"
      }
    }
  },
  "files": [
    "/build/npm"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm run \"/^build:(transpile|types|bundle)$/\"",
    "build:transpile": "rolldown -c rollup.npm.config.mjs",
    "build:bundle": "rolldown -c rollup.bundle.config.mjs",
    "build:dev": "pnpm run \"/^build:(transpile|types)$/\"",
    "build:types": "tsc -p tsconfig.types.json",
    "build:tarball": "pnpm pack",
    "clean": "node ../../scripts/rm.mjs build sentry-replay-*.tgz",
    "format": "oxfmt \"src/**/*.ts\" \"test/**/*.ts\" --write",
    "format:check": "oxfmt \"src/**/*.ts\" \"test/**/*.ts\" --check",
    "lint": "oxlint . --type-aware",
    "lint:types": "oxlint src --type-aware --type-check",
    "lint:fix": "oxlint . --fix --type-aware",
    "lint:es-compatibility": "node ../../scripts/es-check.mjs es2020",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "yalc:publish": "pnpm dlx yalc publish --push --sig"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getsentry/sentry-javascript.git"
  },
  "author": "Sentry",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/getsentry/sentry-javascript/issues"
  },
  "homepage": "https://docs.sentry.io/platforms/javascript/session-replay/",
  "devDependencies": {
    "@sentry-internal/replay-worker": "11.12.0",
    "@sentry-internal/rollup-utils": "11.12.0",
    "@sentry/conventions": "^0.32.0",
    "@sentry/rrweb": "2.46.0",
    "@sentry/rrweb-snapshot": "2.46.0",
    "fflate": "0.8.3",
    "jsdom-worker": "^0.3.0"
  },
  "dependencies": {
    "@sentry/browser-utils": "11.12.0",
    "@sentry/core": "11.12.0"
  },
  "engines": {
    "node": ">=20.19.0 <22.0.0 || >=22.12.0 <23.0.0 || >=23.2.0"
  }
}
