{
  "name": "@sentry/google-cloud-serverless",
  "version": "11.0.0-alpha.1",
  "description": "Official Sentry SDK for Google Cloud Functions",
  "repository": "git://github.com/getsentry/sentry-javascript.git",
  "homepage": "https://github.com/getsentry/sentry-javascript/tree/master/packages/google-cloud-serverless",
  "author": "Sentry",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0 <22.0.0 || >=22.12.0 <23.0.0 || >=23.2.0"
  },
  "files": [
    "/build"
  ],
  "main": "build/cjs/index.js",
  "types": "build/types/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./build/types/index.d.ts",
        "default": "./build/esm/index.js"
      },
      "require": {
        "types": "./build/types/index.d.ts",
        "default": "./build/cjs/index.js"
      }
    },
    "./import": {
      "import": {
        "default": "./build/import-hook.mjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@sentry/conventions": "^0.20.0",
    "@sentry/core": "11.0.0-alpha.1",
    "@sentry/node": "11.0.0-alpha.1",
    "@sentry/server-utils": "11.0.0-alpha.1"
  },
  "devDependencies": {
    "@google-cloud/bigquery": "^5.3.0",
    "@google-cloud/common": "^3.4.1",
    "@types/express": "^5.0.6",
    "@types/node": "^18.19.1",
    "nock": "^14.0.17"
  },
  "peerDependencies": {
    "@types/express": "^4.17.14 || ^5.x"
  },
  "peerDependenciesMeta": {
    "@types/express": {
      "optional": true
    }
  },
  "scripts": {
    "build": "run-p build:transpile build:types",
    "build:dev": "yarn build",
    "build:transpile": "rollup -c rollup.npm.config.mjs",
    "build:types": "tsc -p tsconfig.types.json",
    "build:watch": "run-p build:transpile:watch",
    "build:dev:watch": "yarn build:watch",
    "build:transpile:watch": "rollup -c rollup.npm.config.mjs --watch",
    "build:tarball": "npm pack",
    "circularDepCheck": "madge --circular src/index.ts",
    "clean": "rimraf build coverage sentry-google-cloud-*.tgz",
    "lint:fix": "oxlint . --fix --type-aware",
    "lint": "oxlint . --type-aware",
    "lint:types": "oxlint src --type-aware --type-check",
    "lint:es-compatibility": "es-check es2022 ./build/cjs/*.js && es-check es2022 ./build/esm/*.js --module",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "yalc:publish": "yalc publish --push --sig"
  },
  "volta": {
    "extends": "../../package.json"
  },
  "sideEffects": false
}
