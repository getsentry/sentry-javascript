{
  "name": "@sentry/nestjs",
  "version": "11.12.0",
  "description": "Official Sentry SDK for NestJS",
  "repository": "git://github.com/getsentry/sentry-javascript.git",
  "homepage": "https://github.com/getsentry/sentry-javascript/tree/master/packages/nestjs",
  "author": "Sentry",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0 <22.0.0 || >=22.12.0 <23.0.0 || >=23.2.0"
  },
  "files": [
    "/build",
    "/*.d.ts",
    "/*.d.ts.map"
  ],
  "main": "build/cjs/index.js",
  "module": "build/esm/index.js",
  "types": "build/types/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./build/types/index.d.ts",
        "default": "./build/esm/index.js"
      },
      "require": {
        "types": "./build/types/index.d.ts",
        "default": "./build/cjs/index.js"
      }
    },
    "./setup": {
      "import": {
        "types": "./setup.d.ts",
        "default": "./build/esm/setup.js"
      },
      "require": {
        "types": "./setup.d.ts",
        "default": "./build/cjs/setup.js"
      }
    },
    "./webpack": {
      "import": {
        "types": "./build/types/bundler-plugin/webpack.d.ts",
        "default": "./build/esm/bundler-plugin/webpack.js"
      },
      "require": {
        "types": "./build/types/bundler-plugin/webpack.d.ts",
        "default": "./build/cjs/bundler-plugin/webpack.js"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@sentry/conventions": "^0.32.0",
    "@sentry/core": "11.12.0",
    "@sentry/node": "11.12.0",
    "@sentry/server-utils": "11.12.0"
  },
  "devDependencies": {
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.4.22",
    "@sentry-internal/rollup-utils": "11.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "peerDependencies": {
    "@nestjs/common": "^8.0.0 || ^9.0.0 || ^10.0.0 || ^11.0.0 || ^12.0.0",
    "@nestjs/core": "^8.0.0 || ^9.0.0 || ^10.0.0 || ^11.0.0 || ^12.0.0"
  },
  "scripts": {
    "build": "pnpm run \"/^build:(transpile|types)$/\"",
    "build:dev": "pnpm run build",
    "build:transpile": "rolldown -c rollup.npm.config.mjs",
    "build:types": "pnpm run build:types:core && pnpm run build:types:setup",
    "build:types:core": "tsc -p tsconfig.types.json",
    "build:types:setup": "tsc -p tsconfig.setup-types.json",
    "build:tarball": "pnpm pack",
    "clean": "node ../../scripts/rm.mjs build coverage sentry-nestjs-*.tgz ./*.d.ts ./*.d.ts.map",
    "lint:fix": "oxlint . --fix --type-aware",
    "lint": "oxlint . --type-aware",
    "lint:types": "oxlint src --type-aware --type-check",
    "lint:es-compatibility": "node ../../scripts/es-check.mjs es2022",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "yalc:publish": "pnpm dlx yalc publish --push --sig"
  },
  "nx": {
    "targets": {
      "build:types": {
        "inputs": [
          "production",
          "^production"
        ],
        "dependsOn": [
          "^build:types"
        ],
        "outputs": [
          "{projectRoot}/build/types",
          "{projectRoot}/*.d.ts",
          "{projectRoot}/*.d.ts.map"
        ],
        "cache": true
      }
    }
  },
  "sideEffects": false
}
