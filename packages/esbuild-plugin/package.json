{
  "name": "@sentry/esbuild-plugin",
  "version": "11.12.0",
  "description": "Official Sentry esbuild plugin",
  "repository": "git://github.com/getsentry/sentry-javascript.git",
  "homepage": "https://github.com/getsentry/sentry-javascript/tree/develop/packages/esbuild-plugin",
  "author": "Sentry",
  "license": "MIT",
  "keywords": [
    "Sentry",
    "esbuild",
    "bundler",
    "plugin"
  ],
  "engines": {
    "node": ">=20.19.0 <22.0.0 || >=22.12.0 <23.0.0 || >=23.2.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "/build"
  ],
  "main": "build/cjs/index.js",
  "module": "build/esm/index.js",
  "types": "build/types/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./build/types/index.d.ts",
      "import": "./build/esm/index.js",
      "require": "./build/cjs/index.js"
    }
  },
  "scripts": {
    "build": "run-p build:transpile build:types",
    "build:dev": "pnpm run build",
    "build:transpile": "rolldown -c rollup.npm.config.mjs",
    "build:types": "tsc -p tsconfig.types.json",
    "build:tarball": "pnpm pack",
    "clean": "node ../../scripts/rm.mjs build coverage sentry-esbuild-plugin-*.tgz",
    "lint": "oxlint . --type-aware",
    "lint:fix": "oxlint . --fix --type-aware",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@sentry/bundler-plugins": "11.12.0"
  },
  "devDependencies": {
    "@sentry-internal/rollup-utils": "11.12.0"
  }
}
