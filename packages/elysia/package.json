{
  "name": "@sentry/elysia",
  "version": "11.12.0",
  "description": "Official Sentry SDK for Elysia",
  "repository": "git://github.com/getsentry/sentry-javascript.git",
  "homepage": "https://github.com/getsentry/sentry-javascript/tree/master/packages/elysia",
  "author": "Sentry",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0 <22.0.0 || >=22.12.0 <23.0.0 || >=23.2.0"
  },
  "files": [
    "/build"
  ],
  "main": "build/cjs/index.js",
  "module": "build/esm/index.js",
  "types": "build/types/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./build/types/index.d.ts",
        "default": "./build/esm/index.js"
      },
      "require": {
        "types": "./build/types/index.d.ts",
        "default": "./build/cjs/index.js"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@sentry/bun": "11.12.0",
    "@sentry/core": "11.12.0",
    "@sentry/conventions": "^0.32.0"
  },
  "peerDependencies": {
    "elysia": "^1.4.0"
  },
  "devDependencies": {
    "@sentry-internal/rollup-utils": "11.12.0",
    "bun-types": "^1.2.9",
    "elysia": "^1.4.29"
  },
  "peerDependenciesMeta": {
    "elysia": {
      "optional": false
    }
  },
  "scripts": {
    "build": "pnpm run \"/^build:(transpile|types)$/\"",
    "build:dev": "pnpm run build",
    "build:transpile": "rolldown -c rollup.npm.config.mjs",
    "build:types": "tsc -p tsconfig.types.json",
    "build:tarball": "pnpm pack",
    "clean": "node ../../scripts/rm.mjs build coverage sentry-elysia-*.tgz",
    "lint": "oxlint . --type-aware",
    "lint:types": "oxlint src --type-aware --type-check",
    "lint:fix": "oxlint . --fix --type-aware",
    "lint:es-compatibility": "es-check es2022 ./build/cjs/*.js && es-check es2022 ./build/esm/*.js --module",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "yalc:publish": "pnpm dlx yalc publish --push --sig"
  },
  "sideEffects": false
}
