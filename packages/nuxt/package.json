{
  "name": "@sentry/nuxt",
  "version": "11.10.0",
  "description": "Official Sentry SDK for Nuxt",
  "repository": "git://github.com/getsentry/sentry-javascript.git",
  "homepage": "https://github.com/getsentry/sentry-javascript/tree/master/packages/nuxt",
  "author": "Sentry",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0 <22.0.0 || >=22.12.0 <23.0.0 || >=23.2.0"
  },
  "files": [
    "/build"
  ],
  "main": "build/cjs/index.server.js",
  "module": "build/esm/index.server.js",
  "browser": "build/esm/index.client.js",
  "types": "build/types/index.types.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./build/types/index.types.d.ts",
      "browser": {
        "import": "./build/esm/index.client.js",
        "require": "./build/cjs/index.client.js"
      },
      "node": {
        "import": "./build/esm/index.server.js",
        "require": "./build/cjs/index.server.js"
      },
      "import": "./build/esm/index.server.js",
      "require": "./build/cjs/index.server.js"
    },
    "./module": {
      "types": "./build/module/types.d.ts",
      "import": "./build/module/module.mjs"
    },
    "./module/plugins": {
      "types": "./build/module/runtime/plugins/index.d.ts",
      "import": "./build/module/runtime/plugins/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "nuxt": ">=3.7.0 || 4.x || 5.x",
    "nitro": "2.x || 3.x || 3.0.260311-beta || 3.0.260415-beta || 3.0.260429-beta || 3.0.260522-beta || 3.0.260603-beta || 3.0.260610-beta || 3.0.260903-beta"
  },
  "peerDependenciesMeta": {
    "nitro": {
      "optional": true
    }
  },
  "dependencies": {
    "@nuxt/kit": "^4.6.0",
    "@sentry/browser": "11.10.0",
    "@sentry/cloudflare": "11.10.0",
    "@sentry/conventions": "^0.30.0",
    "@sentry/core": "11.10.0",
    "@sentry/node": "11.10.0",
    "@sentry/bundler-plugins": "11.10.0",
    "@sentry/server-runtime-injection": "11.10.0",
    "@sentry/server-utils": "11.10.0",
    "@sentry/vue": "11.10.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260519.1",
    "@nuxt/nitro-server": "^3.21.11",
    "@nuxt/schema": "^3.21.11",
    "@sentry-internal/rollup-utils": "11.10.0",
    "db0": "^0.3.4",
    "h3": "^1.15.10",
    "nitro": "^3.0.260311-beta",
    "nitropack": "^2.13.4",
    "nuxi": "^3.25.1",
    "nuxt": "3.21.11",
    "unstorage": "^1.17.5",
    "vite": "^8.3.1",
    "vue": "^3.5.41"
  },
  "scripts": {
    "build": "run-s build:types build:transpile",
    "build:dev": "pnpm run build",
    "build:nuxt-module": "rollup -c rollup.module.config.mjs && tsc -p tsconfig.module.json && node scripts/build-module-meta.mjs",
    "build:transpile": "rollup -c rollup.npm.config.mjs && pnpm run build:nuxt-module",
    "build:types": "tsc -p tsconfig.types.json",
    "build:watch": "run-p build:transpile:watch",
    "build:dev:watch": "pnpm run build:watch",
    "build:transpile:watch": "rollup -c rollup.npm.config.mjs --watch",
    "build:tarball": "npm pack",
    "circularDepCheck": "madge --circular src/index.client.ts && madge --circular src/index.server.ts && madge --circular src/index.types.ts",
    "clean": "rimraf build coverage sentry-nuxt-*.tgz",
    "lint:fix": "oxlint . --fix --type-aware",
    "lint": "oxlint . --type-aware",
    "lint:types": "oxlint src --type-aware --type-check",
    "lint:es-compatibility": "es-check es2020 ./build/cjs/*.js && es-check es2020 ./build/esm/*.js --module && es-check es2020 ./build/module/*.mjs --module",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run",
    "test:watch": "vitest --watch",
    "yalc:publish": "yalc publish --push --sig"
  },
  "nx": {
    "targets": {
      "build:transpile": {
        "dependsOn": [
          "^build:transpile",
          "^build:types",
          "build:types"
        ],
        "outputs": [
          "{projectRoot}/build/cjs",
          "{projectRoot}/build/esm",
          "{projectRoot}/build/module"
        ]
      }
    }
  }
}
